/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-bottom: 2rpx solid var(--gray-100);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  background: #ec4899;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-svg-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gray-800);
  letter-spacing: -0.5rpx;
}

.nav-badge {
  font-size: 26rpx;
  color: var(--gray-500);
  font-weight: 500;
}

/* 主内容区 */
.main-container {
  padding: 24rpx 32rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-locked {
  overflow: hidden;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 引导文字 */
.intro-section {
  text-align: center;
  margin: 48rpx 0 64rpx;
}

.intro-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--gray-900);
  margin-bottom: 24rpx;
}

.intro-subtitle {
  display: block;
  font-size: 32rpx;
  color: var(--gray-500);
  line-height: 1.6;
}

/* 分析卡片额外间距 */
.graph-title {
  margin-bottom: 40rpx !important;
}

.analysis-title {
  margin-top: 52rpx;
}

/* 卡片标题颜色变体 */
.input-title::before {
  background: #ec4899;
}

.graph-title::before {
  background: var(--purple-500);
}

.analysis-title::before {
  background: var(--blue-500);
}

/* 输入框 */
.input {
  width: 100%;
  padding: 32rpx;
  font-size: 34rpx;
  border: 4rpx solid var(--gray-200);
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 160rpx;
  line-height: 1.5;
}

.input-hint {
  text-align: right;
  font-size: 24rpx;
  color: var(--gray-400);
  margin-top: 16rpx;
}

/* 关系按钮网格 */
.relation-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin: 32rpx 0;
}

.relation-btn {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gray-700);
  background: var(--gray-50);
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.relation-btn:active {
  background: var(--brand-50);
  color: var(--brand-600);
  border-color: var(--brand-200);
  transform: scale(0.95);
}

.relation-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btns .btn {
  flex: 1;
  height: 88rpx;
  padding: 0;
  font-size: 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  line-height: 1;
}

.btn-calculate {
  flex: 2 !important;
  background: #db2777 !important;
  box-shadow: 0 8rpx 24rpx rgba(219, 39, 119, 0.25) !important;
}

.btn-calculate:active {
  background: #be185d !important;
}

.btn-calculate[disabled] {
  background: #db2777 !important;
  opacity: 0.7;
  color: #ffffff !important;
}

.btn-icon {
  font-size: 28rpx;
}

.btn-svg-icon {
  width: 28rpx;
  height: 28rpx;
  vertical-align: middle;
  margin-right: 4rpx;
  display: inline-block;
}

.trash-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  display: inline-block;
  vertical-align: middle;
}

.btn-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 错误提示 */
.error-card {
  background: var(--red-50);
  border: 2rpx solid var(--red-100);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.error-icon {
  font-size: 36rpx;
}

.error-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--red-500);
  line-height: 1.5;
}

/* 加载状态 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
}

.loading-spinner-large {
  width: 96rpx;
  height: 96rpx;
  border: 8rpx solid var(--brand-200);
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}

.loading-text {
  font-size: 30rpx;
  color: var(--gray-500);
  font-weight: 500;
}

/* 结果卡片 */
.result-card {
  background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 60rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(190, 24, 93, 0.25);
}

/* 装饰圆圈 */
.result-card::before {
  content: '';
  position: absolute;
  top: -64rpx;
  right: -64rpx;
  width: 256rpx;
  height: 256rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(40rpx);
}

.result-card::after {
  content: '';
  position: absolute;
  bottom: -48rpx;
  left: -48rpx;
  width: 192rpx;
  height: 192rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(32rpx);
}

/* 分析切换按钮 */
.analysis-toggle {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.toggle-icon {
  font-size: 24rpx;
}

.toggle-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.toggle-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
}

/* 结果内容 */
.result-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  margin-top: 35rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  margin-bottom: 20rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.result-label {
  display: block;
  font-size: 30rpx;
  color: var(--brand-100);
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.result-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.result-icon {
  font-size: 72rpx;
  opacity: 0.8;
}

.result-text {
  font-size: 80rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -2rpx;
}

/* 流程图容器 */
.flowchart-container {
  width: 100%;
  padding: 24rpx;
  background: var(--gray-50);
  border-radius: 16rpx;
  min-height: 150rpx;
  max-height: 35vh;
  overflow-y: auto;
}

.flowchart-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flowchart-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.flowchart-node-box {
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  text-align: center;
  min-width: 140rpx;
  z-index: 2;
}

.node-group-0 {
  background: var(--blue-500);
  color: #ffffff;
}

.node-group-1 {
  background: #ffffff;
  color: var(--gray-800);
  border: 3rpx solid #fce7f3;
}

.node-group-2 {
  background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
  color: #ffffff;
  border: 3rpx solid #db2777;
}

.node-label {
  display: block;
}

/* 竖直连接线 */
.flowchart-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin: 4rpx 0 8rpx;
}

.connector-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.connector-label-left {
  font-size: 26rpx;
  color: var(--gray-600);
  white-space: nowrap;
}

.connector-line-vertical {
  width: 3rpx;
  height: 40rpx;
  background: var(--gray-300);
}

.connector-arrow {
  font-size: 28rpx;
  color: var(--gray-400);
  font-weight: bold;
  margin-top: 4rpx;
}

/* 计算步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-height: 35vh;
  overflow-y: auto;
  padding-right: 16rpx;
  padding-bottom: 20rpx;
}

.step-item {
  display: flex;
  gap: 24rpx;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-number {
  width: 64rpx;
  height: 64rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gray-500);
  flex-shrink: 0;
}

.step-number-final {
  background: var(--brand-100);
  color: var(--brand-600);
}

.step-line {
  width: 4rpx;
  flex: 1;
  background: var(--gray-100);
  margin: 8rpx 0;
  min-height: 48rpx;
}

.step-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.step-relation {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-800);
}

.step-arrow {
  font-size: 24rpx;
  color: var(--gray-400);
}

.step-result {
  font-size: 32rpx;
  font-weight: 600;
  color: #db2777;
}

.step-explanation {
  font-size: 26rpx;
  color: var(--gray-500);
  background: var(--gray-50);
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-100);
  line-height: 1.5;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  width: 100%;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
  position: relative;
  margin: auto;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-close-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--gray-500);
  border-radius: 16rpx;
  background: var(--gray-50);
  cursor: pointer;
  transition: all 0.2s;
  z-index: 100;
}

.modal-close-btn:active {
  background: var(--gray-100);
}

.modal-scroll-content {
  max-height: 70vh;
  padding: 70rpx 0 40rpx;
  box-sizing: border-box;
}

.modal-section {
  padding: 0 32rpx 24rpx;
  flex-shrink: 0;
}

.modal-section:last-child {
  padding-bottom: 40rpx;
}

.modal-section .card-title {
  margin-top: 0;
  margin-bottom: 16rpx;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 48rpx 0;
  font-size: 24rpx;
  color: var(--gray-400);
}

/* 动画 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}

.animate-fade-in-up {
  animation: fadeInUp 0.4s ease-out;
}

.animate-fade-in-right {
  animation: fadeInRight 0.4s ease-out;
}
